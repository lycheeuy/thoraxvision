# ================= ThoraxVision =================
# Copy to backend/.env and fill in real values.
# Values below are placeholders — nothing is wired up in Phase 1.

# --- Application ---
APP_NAME=ThoraxVision
APP_ENV=development
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Database (Phase 2) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=thoraxvision
POSTGRES_PASSWORD=changeme
POSTGRES_DB=thoraxvision
DATABASE_URL=postgresql+psycopg://thoraxvision:changeme@localhost:5432/thoraxvision

# --- ML (Phase 3) ---
MODEL_PATH=ml_models/densenet121_tb.pth
DEVICE=cpu
IMAGE_SIZE=224

# --- Storage ---
UPLOAD_DIR=uploads
GRADCAM_OUTPUT_DIR=outputs/gradcam
REPORTS_DIR=reports

# --- SQLAlchemy ---
SQL_ECHO=false
